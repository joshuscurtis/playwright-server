# Database (required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/playwright_reports

# Storage type: "local" or "s3"
STORAGE_TYPE=local

# Local storage path (when STORAGE_TYPE=local)
LOCAL_STORAGE_PATH=./data/reports

# S3 storage (when STORAGE_TYPE=s3)
# S3_BUCKET=playwright-reports
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:4566  # LocalStack
# S3_ACCESS_KEY_ID=test
# S3_SECRET_ACCESS_KEY=test
# S3_FORCE_PATH_STYLE=true
