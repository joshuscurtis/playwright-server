# Test environment
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/playwright_reports_test
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./data/test-reports

# S3 tests use LocalStack
S3_BUCKET=test-playwright-reports
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:4566
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3_FORCE_PATH_STYLE=true
